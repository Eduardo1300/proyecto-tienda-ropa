{
  "buildCommand": "cd tienda-vue && npm install && npm run build",
  "devCommand": "cd tienda-vue && npm run dev",
  "installCommand": "cd tienda-vue && npm install",
  "outputDirectory": "tienda-vue/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
